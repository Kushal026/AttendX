datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum DegreeType {
  B_TECH
  B_E
  M_TECH
  B_SC
  M_SC
  MBA
  MCA
}

enum SubjectType {
  THEORY
  LAB
  ELECTIVE
  SEMINAR
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
  PENDING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL_FACULTY
  AUTO_ABSENT
  RFID_CARD
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  ATTENDANCE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  OVERRIDE
  AUTO_MARK
}

// 1. User Model
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password_hash String
  full_name     String
  role          Role
  phone         String?
  avatar_url    String?
  is_active     Boolean         @default(true)
  last_login_at DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updated_at

  student       Student?
  faculty       Faculty?
  notifications Notification[]
  audit_logs    AttendanceAuditLog[]
  settings_mod  SystemSetting[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// 2. Department Model
model Department {
  id                    String     @id @default(uuid())
  code                  String     @unique
  name                  String
  description           String?
  head_of_department_id String?
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updated_at

  courses               Course[]
  faculties             Faculty[]
  students              Student[]

  @@map("departments")
}

// 3. Course Model
model Course {
  id              String      @id @default(uuid())
  department_id   String
  code            String      @unique
  name            String
  degree_type     String
  total_semesters Int         @default(8)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updated_at

  department      Department  @relation(fields: [department_id], references: [id], onDelete: Restrict)
  semesters       Semester[]
  subjects        Subject[]
  students        Student[]

  @@map("courses")
}

// 4. Semester Model
model Semester {
  id              String      @id @default(uuid())
  course_id       String
  semester_number Int
  academic_year   String
  is_current      Boolean     @default(false)
  start_date      DateTime
  end_date        DateTime
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updated_at

  course          Course      @relation(fields: [course_id], references: [id], onDelete: Cascade)
  sections        Section[]
  subjects        Subject[]
  students        Student[]

  @@unique([course_id, semester_number, academic_year])
  @@map("semesters")
}

// 5. Section Model
model Section {
  id                String            @id @default(uuid())
  semester_id       String
  name              String
  capacity          Int               @default(60)
  room_number       String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updated_at

  semester          Semester          @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  students          Student[]
  faculty_subjects  FacultySubject[]
  student_subjects  StudentSubject[]
  class_sessions    ClassSession[]

  @@unique([semester_id, name])
  @@map("sections")
}

// 6. Faculty Model
model Faculty {
  id                  String                @id @default(uuid())
  user_id             String                @unique
  employee_id         String                @unique
  department_id       String
  designation         String
  qualification       String
  specialization      String?
  joining_date        DateTime
  office_room         String?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updated_at

  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department          Department            @relation(fields: [department_id], references: [id], onDelete: Restrict)
  faculty_subjects    FacultySubject[]
  class_sessions      ClassSession[]
  attendance_sessions AttendanceSession[]

  @@map("faculty")
}

// 7. Student Model
model Student {
  id               String            @id @default(uuid())
  user_id          String            @unique
  roll_number      String            @unique
  register_number  String            @unique
  department_id    String
  course_id        String
  semester_id      String
  section_id       String
  batch_year       String
  admission_date   DateTime?
  parent_name      String?
  parent_contact   String?
  current_gpa      Decimal?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updated_at

  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department       Department        @relation(fields: [department_id], references: [id], onDelete: Restrict)
  course           Course            @relation(fields: [course_id], references: [id], onDelete: Restrict)
  semester         Semester          @relation(fields: [semester_id], references: [id], onDelete: Restrict)
  section          Section           @relation(fields: [section_id], references: [id], onDelete: Restrict)
  student_subjects StudentSubject[]
  attendance_logs  Attendance[]

  @@map("students")
}

// 8. Subject Model
model Subject {
  id               String            @id @default(uuid())
  course_id        String
  semester_id      String
  code             String            @unique
  name             String
  credit_hours     Int               @default(3)
  type             SubjectType       @default(THEORY)
  syllabus_url     String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updated_at

  course           Course            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  semester         Semester          @relation(fields: [semester_id], references: [id], onDelete: Restrict)
  faculty_subjects FacultySubject[]
  student_subjects StudentSubject[]
  class_sessions   ClassSession[]

  @@map("subjects")
}

// 9. FacultySubject Model
model FacultySubject {
  id            String      @id @default(uuid())
  faculty_id    String
  subject_id    String
  section_id    String
  academic_year String
  is_primary    Boolean     @default(true)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updated_at

  faculty       Faculty     @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  section       Section     @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([faculty_id, subject_id, section_id, academic_year])
  @@map("faculty_subjects")
}

// 10. StudentSubject Model
model StudentSubject {
  id            String            @id @default(uuid())
  student_id    String
  subject_id    String
  section_id    String
  academic_year String
  status        EnrollmentStatus  @default(ENROLLED)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updated_at

  student       Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject       Subject           @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  section       Section           @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([student_id, subject_id, academic_year])
  @@map("student_subjects")
}

// 11. ClassSession Model
model ClassSession {
  id                  String               @id @default(uuid())
  subject_id          String
  faculty_id          String
  section_id          String
  date                DateTime
  start_time          String
  end_time            String
  room                String
  topic               String?
  status              SessionStatus        @default(SCHEDULED)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updated_at

  subject             Subject              @relation(fields: [subject_id], references: [id], onDelete: Restrict)
  faculty             Faculty              @relation(fields: [faculty_id], references: [id], onDelete: Restrict)
  section             Section              @relation(fields: [section_id], references: [id], onDelete: Restrict)
  attendance_sessions AttendanceSession[]

  @@map("class_sessions")
}

// 12. AttendanceSession Model
model AttendanceSession {
  id                    String                   @id @default(uuid())
  class_session_id      String
  faculty_id            String
  session_token         String                   @unique
  qr_code_hash          String
  start_time            DateTime
  expires_at            DateTime
  status                AttendanceSessionStatus  @default(ACTIVE)
  auto_absent_processed Boolean                  @default(false)
  total_enrolled        Int                      @default(0)
  total_present         Int                      @default(0)
  total_absent          Int                      @default(0)
  created_at            DateTime                 @default(now())
  updated_at            DateTime                 @updated_at

  class_session         ClassSession             @relation(fields: [class_session_id], references: [id], onDelete: Cascade)
  faculty               Faculty                  @relation(fields: [faculty_id], references: [id], onDelete: Restrict)
  attendances           Attendance[]

  @@map("attendance_sessions")
}

// 13. Attendance Model
model Attendance {
  id                    String                @id @default(uuid())
  attendance_session_id String
  student_id            String
  marked_at             DateTime              @default(now())
  status                AttendanceStatus
  method                AttendanceMethod
  ip_address            String?
  device_info           String?
  geo_latitude          Decimal?
  geo_longitude         Decimal?
  verified_by           String?
  notes                 String?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updated_at

  attendance_session    AttendanceSession     @relation(fields: [attendance_session_id], references: [id], onDelete: Cascade)
  student               Student               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  audit_logs            AttendanceAuditLog[]

  @@unique([attendance_session_id, student_id])
  @@map("attendance")
}

// 14. Notification Model
model Notification {
  id          String           @id @default(uuid())
  user_id     String
  title       String
  message     String
  type        NotificationType @default(INFO)
  is_read     Boolean          @default(false)
  read_at     DateTime?
  action_link String?
  created_at  DateTime         @default(now())

  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// 15. AttendanceAuditLog Model
model AttendanceAuditLog {
  id              String           @id @default(uuid())
  attendance_id   String
  performed_by    String
  action          AuditAction
  previous_status AttendanceStatus?
  new_status      AttendanceStatus
  reason          String?
  ip_address      String?
  created_at      DateTime         @default(now())

  attendance      Attendance       @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [performed_by], references: [id], onDelete: Restrict)

  @@map("attendance_audit_logs")
}

// 16. SystemSetting Model
model SystemSetting {
  id          String   @id @default(uuid())
  setting_key String   @unique
  setting_value String
  category    String   @default("GENERAL")
  description String?
  is_public   Boolean  @default(false)
  updated_by  String?
  updated_at  DateTime @default(now()) @updated_at

  user        User?    @relation(fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
