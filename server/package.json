{
  "name": "smart-attendance-server",
  "version": "2.0.0",
  "private": true,
  "description": "Backend REST API & WebSocket service for QR Smart Attendance Management System — Phase 2: Database Architecture",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:validate": "prisma validate --schema=prisma/schema.prisma",
    "db:apply": "tsx src/scripts/apply-migration.ts",
    "db:seed-auth": "tsx src/scripts/seed-auth-users.ts",
    "db:enhance-rls": "tsx src/scripts/enhance-supabase-rls.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:verify": "tsx src/scripts/verify-schema.ts",
    "db:format": "prisma format --schema=prisma/schema.prisma",
    "test:phase3-auth": "tsx src/scripts/verify-phase3-auth.ts",
    "test:phase4-admin": "tsx src/scripts/verify-phase4-admin.ts",
    "test:phase5-faculty": "tsx src/scripts/verify-phase5-faculty.ts",
    "test:phase6-qr": "tsx src/scripts/verify-phase6-qr-session.ts",
    "test:phase7-student": "tsx src/scripts/verify-phase7-student-scan.ts",
    "test:phase8-finalization": "tsx src/scripts/verify-phase8-finalization.ts",
    "test:phase9-history": "tsx src/scripts/verify-phase9-history-stats.ts",
    "test:phase10-reports": "tsx src/scripts/verify-phase10-reports-export.ts",
    "test:phase11-admin": "tsx src/scripts/verify-phase11-admin-system.ts",
    "test:phase12-final": "tsx src/scripts/verify-phase12-final-production.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
